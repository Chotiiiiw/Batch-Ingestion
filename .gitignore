.DS_Store
__pycache__/
*.py[cod]
.venv/

# Generated data can be recreated; do not commit it to Git.
mock-data/output/

# Local environment and credentials must never be committed.
.env
.env.*
!.env.example

# Private authentication keys must stay outside the repository.
*.p8
*.pem

# Airflow runtime files and mounted credentials stay local.
airflow/logs/
airflow/keys/
