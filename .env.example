# Snowflake account identifier in organization-account format.
SNOWFLAKE_ACCOUNT=your_organization-your_account

# Dedicated Snowflake service identity for the ETL pipeline.
SNOWFLAKE_USER=FOOD_DELIVERY_ETL
SNOWFLAKE_ROLE=FOOD_DELIVERY_ETL_ROLE

# Snowflake compute and data context.
SNOWFLAKE_WAREHOUSE=FOOD_DELIVERY_WH
SNOWFLAKE_DATABASE=FOOD_DELIVERY_DW
SNOWFLAKE_SCHEMA=STAGING

# The private key stays outside this repository.
SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake/keys/food_delivery_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=your_private_key_passphrase

# Airflow mounts this host directory read-only inside its containers.
# Use an absolute path and keep the private key outside this repository.
SNOWFLAKE_KEYS_DIR=/absolute/path/to/.snowflake/keys

# Airflow local-development secrets.
AIRFLOW_FERNET_KEY=generate_a_fernet_key
AIRFLOW_API_JWT_SECRET=generate_a_random_secret
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=change_this_password
